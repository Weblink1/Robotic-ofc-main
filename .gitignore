# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ide / agent
.agent

# temporary debug frames, raw video backups & verification screenshots
scripts/*.png
public/assets/robotic/gallery/detect-*
public/assets/robotic/gallery/endframe-*
public/assets/robotic/gallery/frame-*
public/assets/robotic/gallery/test-im*
public/assets/robotic/gallery/*-orig.mp4



# legacy local CMS file (site now uses Supabase)
/data/cms-store.json
